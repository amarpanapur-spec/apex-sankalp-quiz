rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // IMPORTANT: Replace this UID with the UID of your Firebase admin account.
    function isAdmin() { return signedIn() && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'; }

    match /quizzes/{quizId} {
      // Public page queries must include where('status', '==', 'published').
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }
    match /students/{studentId} {
      allow create, read, update: if signedIn() && (request.auth.uid == studentId || isAdmin());
      allow delete: if isAdmin();
    }
    match /results/{resultId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /leaderboard/{entryId} {
      // Keep only display name, quiz name, marks and accuracy here; never put phone numbers.
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
